@!namespace("@ohos.bluetooth.bas", "bas")
@!sts_inject_into_module("import { BusinessError, AsyncCallback } from '@ohos.base';")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("bluetoothBas_taihe_native.z", "@ohos.bluetooth.bas") }
""")

from ohos.bluetooth.common use BluetoothAddress;

function IsBasSupported(): bool;

@rename("getRemoteDeviceBatteryInfo")
function GetRemoteDeviceBatteryInfoPromise(deviceId: BluetoothAddress): @sts_type("Promise<BatteryInfo>") Opaque;

@rename("getRemoteDeviceBatteryInfo")
function GetRemoteDeviceBatteryInfoAsync(deviceId: BluetoothAddress, callback: @sts_type("AsyncCallback<BatteryInfo>") Opaque): void;

function OnBatteryChange(callback:(data: BatteryInfo) => void): void;
function OffBatteryChange(callback: Optional<(data: BatteryInfo) => void>): void;

struct BatteryInfo {
    deviceId: BluetoothAddress;
    batteryLevel: i32;
}


