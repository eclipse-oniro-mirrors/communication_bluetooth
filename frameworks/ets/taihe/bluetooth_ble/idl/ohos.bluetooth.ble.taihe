@!namespace("@ohos.bluetooth.ble", "ble")

@!sts_inject_into_module("import { BusinessError, AsyncCallback } from '@ohos.base';")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("bluetoothBle_taihe_native.z", "@ohos.bluetooth.ble") }
""")
from ohos.bluetooth.constant use ProfileConnectionState;
from ohos.bluetooth.connection use BluetoothTransport;

struct ScanReport {
    reportType: ScanReportType;
    scanResult: Array<ScanResult>;
}
enum ScanReportType: i32 {
    ON_FOUND = 1,
    ON_LOST = 2,
    ON_BATCH = 3
}
struct ScanResult {
    deviceId: String;
    rssi: i32;
    data: @arraybuffer Array<u8>;
    deviceName: String;
    connectable: bool;
}

enum MatchMode: i32 {
    MATCH_MODE_AGGRESSIVE = 1,
    MATCH_MODE_STICKY = 2
}

struct AdvertisingEnableParams {
    advertisingId: i32;
    duration: Optional<i32>;
}

struct DescriptorWriteRequest {
    deviceId: String;
    transId: i32;
    offset: i32;
    isPrepared: bool;
    needRsp: bool;
    value: @arraybuffer Array<u8>;
    descriptorUuid: String;
    characteristicUuid: String;
    serviceUuid: String;
}

struct DescriptorReadRequest {
    deviceId: String;
    transId: i32;
    offset: i32;
    descriptorUuid: String;
    characteristicUuid: String;
    serviceUuid: String;
}

struct AdvertiseSetting {
    interval: Optional<i32>;
    txPower: Optional<i32>;
    connectable: Optional<bool>;
    isExtended: Optional<bool>;
}

struct NotifyCharacteristic {
    serviceUuid: String;
    characteristicUuid: String;
    characteristicValue: @arraybuffer Array<u8>;
    confirm: bool;
}

struct ScanFilter {
    deviceId: Optional<String>;
    name: Optional<String>;
    serviceUuid: Optional<String>;
    serviceUuidMask: Optional<String>;
    serviceSolicitationUuid: Optional<String>;
    serviceSolicitationUuidMask: Optional<String>;
    serviceData: Optional<@arraybuffer Array<u8>>;
    serviceDataMask: Optional<@arraybuffer Array<u8>>;
    manufactureId: Optional<i32>;
    manufactureData: Optional<@arraybuffer Array<u8>>;
    manufactureDataMask: Optional<@arraybuffer Array<u8>>;
}

union ScanFilterNullValue {
    filters: Array<ScanFilter>;
    @null nValue;
}

struct CharacteristicReadRequest {
    deviceId: String;
    transId: i32;
    offset: i32;
    characteristicUuid: String;
    serviceUuid: String;
}

struct CharacteristicWriteRequest {
    deviceId: String;
    transId: i32;
    offset: i32;
    isPrepared: bool;
    needRsp: bool;
    value: @arraybuffer Array<u8>;
    characteristicUuid: String;
    serviceUuid: String;
}

function StopBLEScan(): void;

struct ServerResponse {
    deviceId: String;
    transId: i32;
    status: i32;
    offset: i32;
    value: @arraybuffer Array<u8>;
}

struct ScanOptions {
    interval: Optional<i32>;
    dutyMode: Optional<ScanDuty>;
    matchMode: Optional<MatchMode>;
    phyType: Optional<PhyType>;
    reportMode: Optional<ScanReportMode>;
    isExtended: Optional<bool>;
    scanEnhanceMode: Optional<ScanEnhanceMode>;
}

enum ScanDuty: i32 {
    SCAN_MODE_LOW_POWER = 0,
    SCAN_MODE_BALANCED = 1,
    SCAN_MODE_LOW_LATENCY = 2
}

enum PhyType: i32 {
    PHY_LE_1M = 1,
    PHY_LE_ALL_SUPPORTED = 255
}

enum ScanReportMode: i32 {
    NORMAL = 1,
    BATCH = 2,
    FENCE_SENSITIVITY_LOW = 10,
    FENCE_SENSITIVITY_HIGH = 11
}

struct BLECharacteristic {
    serviceUuid: String;
    characteristicUuid: String;
    characteristicValue: @arraybuffer Array<u8>;
    descriptors: Array<BLEDescriptor>;
    properties: Optional<GattProperties>;
    characteristicValueHandle: Optional<i32>;
    permissions: Optional<GattPermissions>;
}

struct ScanEnhanceMode {
    enhanceMode: EnhanceMode;
    timeout: i32;
}

enum EnhanceMode: i32 {
    BLE_SCAN_ENHANCE_MODE_BALANCED = 0,
    BLE_SCAN_ENHANCE_MODE_MEDIUM = 1,
    BLE_SCAN_ENHANCE_MODE_FAST = 2,
    BLE_SCAN_ENHANCE_MODE_ULTRA_FAST = 3
}

@class struct BLECharacteristicInfo {
   @extends characteristic: BLECharacteristic;
}

struct AdvertisingStateChangeInfo {
    advertisingId: i32;
    state: AdvertisingState;
}

enum AdvertisingState: i32 {
    STARTED = 1,
    ENABLED = 2,
    DISABLED = 3,
    STOPPED = 4
}

struct BLEDescriptor {
    serviceUuid: String;
    characteristicUuid: String;
    descriptorUuid: String;
    descriptorValue: @arraybuffer Array<u8>;
    descriptorHandle: Optional<i32>;
    permissions: Optional<GattPermissions>;
}

@class struct BLEDescriptorInfo {
    @extends descriptor: BLEDescriptor;
}

struct GattProperties {
    write: Optional<bool>;
    writeNoResponse: Optional<bool>;
    read: Optional<bool>;
    notify: Optional<bool>;
    indicate: Optional<bool>;
    broadcast: Optional<bool>;
    authenticatedSignedWrite: Optional<bool>;
    extendedProperties: Optional<bool>;
}

@class struct GattPropertiesInfo {
    @extends gattProperties: GattProperties;
}

enum GattWriteType: i32 {
    WRITE = 1,
    WRITE_NO_RESPONSE = 2
}

struct GattPermissions {
    read: Optional<bool>;
    readEncrypted: Optional<bool>;
    readEncryptedMitm: Optional<bool>;
    write: Optional<bool>;
    writeEncrypted: Optional<bool>;
    writeEncryptedMitm: Optional<bool>;
    writeSigned: Optional<bool>;
    writeSignedMitm: Optional<bool>;
}

@class struct GattPermissionsInfo {
    @extends gattPermissions: GattPermissions;
}

union UndefinedType {
    @undefined undefined;
}

function StopAdvertising(): void;

@rename("stopAdvertising")
function StopAdvertisingPromise(advertisingId: i32): @sts_type("Promise<void>") Opaque;

@rename("stopAdvertising")
function StopAdvertisingAsync(advertisingId: i32, callback: @sts_type("AsyncCallback<void>") Opaque): void;

struct GattSetting {
    autoConnect: Optional<bool>;
    transport: Optional<BluetoothTransport>;
}

function OnAdvertisingStateChange(callback:(data: AdvertisingStateChangeInfo) => void): void;
function OffAdvertisingStateChange(callback: Optional<(data: AdvertisingStateChangeInfo) => void>): void;

function OnBLEDeviceFind(callback:(data: Array<ScanResult>) => void): void;
function OffBLEDeviceFind(callback: Optional<(data: Array<ScanResult>) => void>): void;

interface GattClientDevice {
    SetBLEMtuSize(mtu: i32): void;
    Connect(): void;
    Disconnect(): void;

    Close(): void;

    @gen_async("getDeviceName")
    @gen_promise("getDeviceName")
    GetDeviceNameSync(): String;

    @rename("readCharacteristicValue")
    ReadCharacteristicValuePromise(characteristic: BLECharacteristic):  @sts_type("Promise<BLECharacteristic>") Opaque;

    @rename("readCharacteristicValue")
    ReadCharacteristicValueAsync(characteristic: BLECharacteristic, callback: @sts_type("AsyncCallback<BLECharacteristic>") Opaque): void;

    @rename("readDescriptorValue")
    ReadDescriptorValuePromise(descriptor: BLEDescriptor):  @sts_type("Promise<BLEDescriptor>") Opaque;

    @rename("readDescriptorValue")
    ReadDescriptorValueAsync(descriptor: BLEDescriptor, callback: @sts_type("AsyncCallback<BLEDescriptor>") Opaque): void;

    @rename("setCharacteristicChangeIndication")
    SetCharacteristicChangeIndicationPromise(characteristic: BLECharacteristic, enable: bool):  @sts_type("Promise<void>") Opaque;

    @rename("setCharacteristicChangeIndication")
    SetCharacteristicChangeIndicationAsync(characteristic: BLECharacteristic, enable: bool, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    @rename("readPhy")
    ReadPhyPromise(): @sts_type("Promise<PhyValue>") Opaque;

    @rename("setPhy")
    SetPhyPromise(phyValue: PhyValue): @sts_type("Promise<void>") Opaque;

    @rename("writeCharacteristicValueWithContext")
    WriteCharacteristicValueWithContextPromise(characteristic: BLECharacteristic, writeType: GattWriteType):  @sts_type("Promise<GattRspContext>") Opaque;

    @rename("writeDescriptorValue")
    WriteDescriptorValuePromise(descriptor: BLEDescriptor): @sts_type("Promise<void>") Opaque;

    @rename("writeDescriptorValue")
    WriteDescriptorValueAsync(descriptor: BLEDescriptor, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    @gen_async("getServices")
    @gen_promise("getServices")
    GetServicesSync(): Array<GattService>;

    OnBlePhyUpdate(callback:(data: PhyValue) => void): void;
    OffBlePhyUpdate(callback: Optional<(data: PhyValue) => void>): void;

    @rename("setCharacteristicChangeNotification")
    SetCharacteristicChangeNotificationPromise(characteristic: BLECharacteristic, enable: bool):  @sts_type("Promise<void>") Opaque;

    @rename("setCharacteristicChangeNotification")
    SetCharacteristicChangeNotificationAsync(characteristic: BLECharacteristic, enable: bool, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    @rename("getRssiValue")
    GetRssiValuePromise(): @sts_type("Promise<int>") Opaque;

    @rename("getRssiValue")
    GetRssiValueAsync(callback: @sts_type("AsyncCallback<int>") Opaque): void;

    @rename("setBLEMtu")
    SetBLEMtuPromise(mtu: i32): @sts_type("Promise<int>") Opaque;

    @rename("setBLEMtu")
    SetBLEMtuAsync(mtu: i32, callback: @sts_type("AsyncCallback<int>") Opaque): void;

    @rename("writeCharacteristicValue")
    WriteCharacteristicValuePromise(characteristic: BLECharacteristic, writeType: GattWriteType):  @sts_type("Promise<void>") Opaque;

    @rename("writeCharacteristicValue")
    WriteCharacteristicValueAsync(characteristic: BLECharacteristic, writeType: GattWriteType, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    OnBLEMtuChange(callback:(data: i32) => void): void;
    OffBLEMtuChange(callback: Optional<(data: i32) => void>): void;

    OnServiceChange(callback: (data: UndefinedType) => void): void;
    OffServiceChange(callback: Optional<(data: UndefinedType) => void>): void;

    OnBLECharacteristicChange(callback:(data: BLECharacteristic) => void): void;
    OffBLECharacteristicChange(callback: Optional<(data: BLECharacteristic) => void>): void;

    @rename("updateConnectionParam")
    UpdateConnectionParamPromise(param: ConnectionParam): @sts_type("Promise<void>") Opaque;

    @rename("updateConnectionParam")
    UpdateConnectionParamAsync(param: ConnectionParam, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    OnBLEConnectionStateChange(callback:(data: BLEConnectionChangeState) => void): void;
    OffBLEConnectionStateChange(callback: Optional<(data: BLEConnectionChangeState) => void>): void;

    GetConnectedState(): ProfileConnectionState;
}

enum ConnectionParam : i32 {
    LOW_POWER = 1,
    BALANCED = 2,
    HIGH = 3
}

function CreateGattClientDevice(deviceId: String): GattClientDevice;

interface GattServer {
    Close(): void;
    AddService(service: GattService): void;
    RemoveService(serviceUuid: String): void;
    SendResponse(serverResponse: ServerResponse): void;

    @rename("notifyCharacteristicChanged")
    NotifyCharacteristicChangedPromise(deviceId: String, notifyCharacteristic: NotifyCharacteristic):  @sts_type("Promise<void>") Opaque;

    @rename("notifyCharacteristicChanged")
    NotifyCharacteristicChangedAsync(deviceId: String, notifyCharacteristic: NotifyCharacteristic, callback: @sts_type("AsyncCallback<void>") Opaque): void;

    OnBlePhyUpdate(callback:(data: PhyValue) => void): void;
    OffBlePhyUpdate(callback: Optional<(data: PhyValue) => void>): void;

    @rename("setPhy")
    SetPhyPromise(deviceId: String, phyValue: PhyValue): @sts_type("Promise<void>") Opaque;

    @rename("readPhy")
    ReadPhyPromise(deviceId: String): @sts_type("Promise<PhyValue>") Opaque;

    OnBLEMtuChange(callback:(data: i32) => void): void;
    OffBLEMtuChange(callback: Optional<(data: i32) => void>): void;

    Disconnect(deviceId: String): void;
    Connect(deviceId: String, autoConnect: Optional<bool>): void;

    OnCharacteristicRead(callback:(data: CharacteristicReadRequest) => void): void;
    OffCharacteristicRead(callback: Optional<(data: CharacteristicReadRequest) => void>): void;

    OnCharacteristicWrite(callback:(data: CharacteristicWriteRequest) => void): void;
    OffCharacteristicWrite(callback: Optional<(data: CharacteristicWriteRequest) => void>): void;

    GetConnectedState(deviceId: String): ProfileConnectionState;

    GetService(serviceUuid: String): GattService;

    OnConnectionStateChange(callback:(data: BLEConnectionChangeState) => void): void;
    OffConnectionStateChange(callback: Optional<(data: BLEConnectionChangeState) => void>): void;

    OnDescriptorWrite(callback:(data: DescriptorWriteRequest) => void): void;
    OffDescriptorWrite(callback: Optional<(data: DescriptorWriteRequest) => void>): void;

    OnDescriptorRead(callback:(data: DescriptorReadRequest) => void): void;
    OffDescriptorRead(callback: Optional<(data: DescriptorReadRequest) => void>): void;

    RemoveAllServices(): void;
    GetServices(): Array<GattService>;
}

function CreateGattServer(): GattServer;

struct AdvertiseData {
    serviceUuids: Array<String>;
    manufactureData: Array<ManufactureData>;
    serviceData: Array<ServiceData>;
    includeDeviceName: Optional<bool>;
    includeTxPower: Optional<bool>;
}

struct AdvertisingParams {
    advertisingSettings: AdvertiseSetting;
    advertisingData: AdvertiseData;
    advertisingResponse: Optional<AdvertiseData>;
    duration: Optional<i32>;
}
struct ManufactureData {
    manufactureId: i32;
    manufactureValue: @arraybuffer Array<u8>;
}

struct ServiceData {
    serviceUuid: String;
    serviceValue: @arraybuffer Array<u8>;
}

struct GattService {
    serviceUuid: String;
    isPrimary: bool;
    characteristics: Array<BLECharacteristic>;
    includeServices: Optional<Array<GattService>>;
}

struct BLEConnectionChangeState {
    deviceId: String;
    state: ProfileConnectionState;
}

struct AdvertisingDisableParams {
    advertisingId: i32;
}

struct PhyValue {
    txPhy: BlePhy;
    rxPhy: BlePhy;
    phyMode: Optional<CodedPhyMode>;
}

struct GattRspContext {
    timestamp: i64;
}

enum BlePhy: i32 {
    BLE_PHY_1M = 1,
    BLE_PHY_2M = 2,
    BLE_PHY_CODED = 3,
}

enum CodedPhyMode: i32 {
    BLE_PHY_CODED_S2 = 1,
    BLE_PHY_CODED_S8 = 2
}


interface BleScanner {
    @rename("startScan")
    StartScanPromise(filters: ScanFilterNullValue, options: Optional<ScanOptions>):  @sts_type("Promise<void>") Opaque;

    @rename("stopScan")
    StopScanPromise(): @sts_type("Promise<void>") Opaque;

    OnBLEDeviceFind(callback:(data: ScanReport) => void): void;
    OffBLEDeviceFind(callback: Optional<(data: ScanReport) => void>): void;
}

function CreateBleScanner(): BleScanner;
function GetConnectedBLEDevices(): Array<String>;
function StartBLEScan(filters: ScanFilterNullValue, options: Optional<ScanOptions>): void;
function StartAdvertising(setting: AdvertiseSetting, advData: AdvertiseData, advResponse: Optional<AdvertiseData>): void;

@rename("startAdvertising")
function StartAdvertisingPromise(advertisingParams: AdvertisingParams): @sts_type("Promise<int>") Opaque;

@rename("startAdvertising")
function StartAdvertisingAsync(advertisingParams: AdvertisingParams, callback: @sts_type("AsyncCallback<int>") Opaque): void;

@rename("disableAdvertising")
function DisableAdvertisingPromise(advertisingDisableParams: AdvertisingDisableParams):  @sts_type("Promise<void>") Opaque;

@rename("disableAdvertising")
function DisableAdvertisingAsync(advertisingDisableParams: AdvertisingDisableParams, callback: @sts_type("AsyncCallback<void>") Opaque): void;

@rename("enableAdvertising")
function EnableAdvertisingPromise(advertisingEnableParams: AdvertisingEnableParams): @sts_type("Promise<void>") Opaque;

@rename("enableAdvertising")
function EnableAdvertisingAsync(advertisingEnableParams: AdvertisingEnableParams, callback: @sts_type("AsyncCallback<void>") Opaque): void;
