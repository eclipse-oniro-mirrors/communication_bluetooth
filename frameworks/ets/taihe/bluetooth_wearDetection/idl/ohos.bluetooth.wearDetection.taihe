@!namespace("@ohos.bluetooth.wearDetection", "wearDetection")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("bluetoothWearDetection_taihe_native.z", "@ohos.bluetooth.wearDetection") }
""")

@rename("enableWearDetection")
@async
function EnableWearDetectionAsync(deviceId: String): void;
@rename("enableWearDetection")
@promise
function EnableWearDetectionPromise(deviceId: String): void;

@rename("disableWearDetection")
@async
function DisableWearDetectionAsync(deviceId: String): void;
@rename("disableWearDetection")
@promise
function DisableWearDetectionPromise(deviceId: String): void;

@rename("isWearDetectionSupported")
@async
function IsWearDetectionSupportedAsync(deviceId: String): bool;
@rename("isWearDetectionSupported")
@promise
function IsWearDetectionSupportedPromise(deviceId: String): bool;

@rename("isWearDetectionEnabled")
@async
function IsWearDetectionEnabledAsync(deviceId: String): bool;
@rename("isWearDetectionEnabled")
@promise
function IsWearDetectionEnabledPromise(deviceId: String): bool;
