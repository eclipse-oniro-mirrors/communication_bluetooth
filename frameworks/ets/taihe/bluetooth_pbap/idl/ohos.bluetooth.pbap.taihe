@!namespace("@ohos.bluetooth.pbap", "pbap")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("bluetoothPbap_taihe_native.z", "@ohos.bluetooth.pbap") }
""")
from ohos.bluetooth.baseProfile use BaseProfile;
from ohos.bluetooth.constant use AccessAuthorization;
@!sts_inject_into_module("import {baseProfile} from './@ohos.bluetooth.baseProfile';")

function CreatePbapServerProfile(): PbapServerProfile;
interface PbapServerProfile : BaseProfile {
    @!sts_inject_into_class("""on(type: String, callback: object): void {
        if (type === "connectionStateChange") {
            this.onConnectionStateChange(callback as (info: baseProfile.StateChangeParam) => void);
        }
    }
    """)

    @!sts_inject_into_class("""off(type: String, callback?: object): void {
        if (type === "connectionStateChange") {
            this.offConnectionStateChange(callback as ((info: baseProfile.StateChangeParam) => void) | undefined);
        }
    }
    """)

    @gen_async("getPhoneBookAccessAuthorization")
    @gen_promise("getPhoneBookAccessAuthorization")
    GetPhoneBookAccessAuthorizationSync(deviceId: String): AccessAuthorization;

    @gen_async("getShareType")
    @gen_promise("getShareType")
    GetShareTypeSync(deviceId: String): ShareType;

    @gen_async("setShareType")
    @gen_promise("setShareType")
    SetShareTypeSync(deviceId: String, type: ShareType): void;

    @gen_async("setPhoneBookAccessAuthorization")
    @gen_promise("setPhoneBookAccessAuthorization")
    SetPhoneBookAccessAuthorizationSync(deviceId: String, authorization: AccessAuthorization): void;

    Disconnect(deviceId: String): void;
}

enum ShareType: i32 {
    SHARE_NAME_AND_PHONE_NUMBER = 0,
    SHARE_ALL = 1,
    SHARE_NOTHING = 2
}