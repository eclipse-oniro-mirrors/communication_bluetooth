import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")

SUBSYSTEM_DIR = "//foundation/communication"

copy_taihe_idl("bluetooth_common_taihe") {
  sources = [ "idl/ohos.bluetooth.common.taihe" ]
}

subsystem_name = "communication"
part_name = "bluetooth"
taihe_generated_file_path_common = "$taihe_file_path/out/$subsystem_name/$part_name/common"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "${taihe_generated_file_path_common}"
  deps = [ ":bluetooth_common_taihe" ]
  outputs = [
    "$taihe_generated_file_path/src/ohos.bluetooth.common.ani.cpp",
    "$taihe_generated_file_path/src/ohos.bluetooth.common.abi.c",
  ]
}

taihe_shared_library("bluetoothCommon_taihe_native") {
  cflags_cc = [
    "-Os",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
  ]
  ldflags = [
    "-Wl,--as-needed",
    "-Wl,--gc-sections",
  ]
  shlib_type = "ani"
  taihe_generated_file_path = "${taihe_generated_file_path_common}"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  sources = get_target_outputs(":run_taihe")
  include_dirs = [
    "include",
    "src",
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner/include",
    "$SUBSYSTEM_DIR/bluetooth/interfaces/inner_api/include"
  ]
  sources += [
    "src/ani_constructor.cpp",
    "src/ohos.bluetooth.common.impl.cpp",
  ]
  deps = [
    ":run_taihe",
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner:btframework",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]
  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    boundary_sanitize = true  # Enable boundary san detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    cfi_vcall_icall_only = true  # CFI optimization, restrict CFI detection scope
    integer_overflow = true  # Enable integer overflow detection
    ubsan = true  # Enable some Ubsan options
    debug = false
  }
}

generate_static_abc("bluetoothCommon_abc") {
  base_url = "${taihe_generated_file_path_common}"
  files = [ "${taihe_generated_file_path_common}/@ohos.bluetooth.common.ets" ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/bluetoothCommon_abc.abc"
  dependencies = [ ":run_taihe" ]
}

ohos_prebuilt_etc("bluetoothCommon_etc") {
  source = "$target_out_dir/bluetoothCommon_abc.abc"
  module_install_dir = "framework"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  deps = [ ":bluetoothCommon_abc" ]
}

group("bluetoothCommon_taihe") {
  deps = [
    ":bluetoothCommon_etc",
    ":bluetoothCommon_taihe_native"
  ]
  # deps = [":run_taihe"]
}