@!namespace("@ohos.bluetooth.common", "common")
@!sts_inject("""
static { loadLibraryWithPermissionCheck("bluetoothCommon_taihe_native.z", "@ohos.bluetooth.common") }
""")

struct BluetoothAddress{
    address: String;
    addressType: BluetoothAddressType;
    rawAddressType: Optional<BluetoothRawAddressType>;
}

enum BluetoothAddressType: i32 {
    VIRTUAL = 1,
    REAL = 2,
}

enum BluetoothRawAddressType: i32 {
    PUBLIC = 0,
    RANDOM = 1,
}