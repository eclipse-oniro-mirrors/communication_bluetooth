import("//build/test.gni")

module_output_path = "bluetooth/server_test"
SUBSYSTEM_DIR = "//vendor/huawei/foundation/communication"

###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "mock/include",
    "$SUBSYSTEM_DIR/bluetooth/services/bluetooth/service/src/common",
    "$SUBSYSTEM_DIR/bluetooth/services/bluetooth/service/src/",
    "$SUBSYSTEM_DIR/bluetooth/services/bluetooth/service/src/base",
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
  ]
}

ohos_moduletest("btsvr_module_test") {
  module_out_path = module_output_path
  sources = [ "moduletest/hosttest/host_srv_module_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "$SUBSYSTEM_DIR/bluetooth/services/bluetooth/server:bluetooth_server_static",
    "$SUBSYSTEM_DIR/bluetooth/services/bluetooth/service:btservice_static",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "resource_management:global_resmgr",
    "bounds_checking_function:libsec_shared",
    "googletest:gmock_main",
    "googletest:gtest_main",
  ]
}

################################################################################
group("moduletest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [ ":btsvr_module_test" ]
  }
}
