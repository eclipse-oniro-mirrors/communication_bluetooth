import("//build/test.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")
module_output_path = "bluetooth/bluetooth"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
PART_DIR_FRAMEWORK = "//foundation/communication/bluetooth/frameworks"
BT_SERVICE_DIR = "$PART_DIR/service"

###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = [
    "-Werror",
    "-Wno-macro-redefined",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unused-const-variable",
    "-Wno-deprecated-builtins",
    "-Wno-defaulted-function-deleted",
    "-Woverloaded-virtual",
  ]
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "include",
    "$PART_DIR/ipc/common",
  ]

  include_dirs += [
    "$BT_SERVICE_DIR/include",
    "$BT_SERVICE_DIR/src",
    "$BT_SERVICE_DIR/src/avsync",
    "$BT_SERVICE_DIR/src/base",
    "$BT_SERVICE_DIR/src/common",
    "$BT_SERVICE_DIR/src/util",
    "$BT_SERVICE_DIR/src/classic",
    "$PART_DIR/common",
  ]

  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_audio_manager_unit_test") {
  module_out_path = module_output_path
  sources = [ "audio_manager_test.cpp" ]

  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$PART_DIR/service:btservice_static",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "bounds_checking_function:libsec_shared",
    "libxml2:libxml2",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_audio_manager_info_unit_test") {
  module_out_path = module_output_path
  sources = [ "bluetooth_audio_manager_info_test.cpp" ]

  include_dirs = [
    "$BT_SERVICE_DIR/src/avrcp_tg",
    "$BT_SERVICE_DIR/src/bluetooth_audio_manager",
    "$BT_SERVICE_DIR/src/bluetooth_audio_manager_info",
  ]

  configs = [
    ":module_private_config",
    "${bluetooth_unittest_utils_path}:unitest_common_config",
  ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/stack_interface:stack_interface",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "cJSON:cjson",
    "bounds_checking_function:libsec_shared",
    "libxml2:libxml2",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_bluetooth_audio_manager_unit_test") {
  module_out_path = module_output_path
  sources = [ "bluetooth_audio_manager_test.cpp" ]
  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    debug = false
    blocklist = "./libbt_audio_manager_blocklist.txt"
  }
  include_dirs = [
    "$BT_SERVICE_DIR/src/avrcp_tg",
    "$BT_SERVICE_DIR/src/bluetooth_audio_manager",
    "$BT_SERVICE_DIR/src/bluetooth_audio_manager_info",
    "$BT_SERVICE_DIR/src/common",
    "$PART_DIR_FRAMEWORK/inner/ipc/common",
  ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/server:bluetooth_server_static",
    "$PART_DIR/stack_interface:stack_interface",
  ]

  external_deps = [
    "audio_framework:audio_policy_manager",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "cJSON:cjson",
    "bounds_checking_function:libsec_shared",
    "libxml2:libxml2",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_audio_manager_info_unit_test",
      ":btfw_audio_manager_unit_test",
      ":btfw_bluetooth_audio_manager_unit_test",
    ]
  } else if (defined(target_platform) && target_platform == "car") {
    deps += [ ":btfw_bluetooth_audio_manager_unit_test" ]
  }
}
