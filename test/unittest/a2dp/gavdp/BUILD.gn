import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
FRAMWORK_DIR = "//foundation/communication"

###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = [
    "-fPIC",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unreachable-code-return",
    "-Wno-defaulted-function-deleted",
    "-Wno-gnu-variable-sized-type-not-at-end",
    "-Wno-format-nonliteral",
    "-Wno-inconsistent-missing-override",
    "-Wno-unreachable-code",
    "-Wno-range-loop-construct",
    "-Wno-reorder-init-list",
    "-Wno-unused-function",
    "-Wno-unused-result",
    "-Wno-unused-variable",
    "-Wno-unused-const-variable",
    "-Wno-format",
    "-Wno-pessimizing-move",
    "-Wno-unknown-warning-option",
    "-Wno-final-dtor-non-final-class",
    "-Wno-header-hygiene",
    "-Wno-unused-private-field",
    "-Wno-error=unused-function",
    "-Wno-error=unused-variable",
    "-Wno-deprecated-builtins",
    "-Wno-unused-but-set-variable",
  ]
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  cflags_cc = cflags

  include_dirs = [
    "mock/include",
    "$FRAMWORK_DIR/bluetooth/interfaces/inner_api/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/common",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/parcel",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/base",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/common",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/dialog",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/util",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/classic",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/include",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/gavdp",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/permission",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/hfp_ag",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service/src/avsync",
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_a2dp_service_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true                            # Enable/disable control flow integrity detection
    cfi_cross_dso = true                  # Cross-SO CFI Checks
    debug = false
  }
  sources = [ "a2dp_service_test.cpp" ]

  configs = [
    ":module_private_config",
    "${bluetooth_config_path}:feature_flags",
    "${bluetooth_unittest_utils_path}:unitest_common_config",
  ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service:btservice_static",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/server:bluetooth_server_static",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/btchr:btchr",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "ability_runtime:abilitykit_native",
    "ability_runtime:extension_manager",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "call_manager:tel_call_manager_api",
    "core_service:tel_core_service_api",
    "state_registry:tel_state_registry_api",
    "audio_framework:audio_policy_manager",
    "cJSON:cjson",
    "battery_manager:batterysrv_client",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_a2dp_service_statemachine_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true                            # Enable/disable control flow integrity detection
    cfi_cross_dso = true                  # Cross-SO CFI Checks
    debug = false
  }
  sources = [
    "a2dp_service_codec_test.cpp",
    "a2dp_service_state_machine_test.cpp",
  ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/service:btservice_static",
    "$FRAMWORK_DIR/bluetooth/services/bluetooth/server:bluetooth_server_static",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_a2dp_service_unit_test",
      ":btfw_a2dp_service_statemachine_unit_test",
    ]
  }
}
