import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
FRAMWORK_DIR = "//foundation/communication"
VENDOR_BLUETOOTH_PATH = "//foundation/communication/bluetooth/services/bluetooth"

###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "mock/include",
    "$FRAMWORK_DIR/bluetooth/interfaces/inner_api/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/include",
    "$VENDOR_BLUETOOTH_PATH/ipc/include",
    "$VENDOR_BLUETOOTH_PATH/server/include",
    "$VENDOR_BLUETOOTH_PATH/service/src/permission",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/interface",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/common",
    "//foundation/communication/bluetooth/frameworks/inner/ipc/parcel",
    "//foundation/communication/bluetooth/test/fuzztest/config",
    "//foundation/communication/bluetooth/test/unittest/config"
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_a2dp_snk_unit_test") {
  module_out_path = module_output_path

  sources = [ "a2dp_snk_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
   ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_a2dp_src_unit_test") {
  module_out_path = module_output_path

  sources = [ "a2dp_src_test.cpp" ]

  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }

  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    debug = false
  }
}

ohos_unittest("btfw_a2dp_parcel_unit_test") {
  module_out_path = module_output_path

  include_dirs = [
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/parcel",
  ]
  sources = [ "a2dp_parcel_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_a2dp_src_stub_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "./libbt_a2dp_blocklist.txt"
  }
  sources = [ "a2dp_src_stub_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$VENDOR_BLUETOOTH_PATH/server:bluetooth_server_static",
    ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_bluetooth_a2dp_src_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "./libbt_a2dp_blocklist.txt"
  }
  sources = [ "bluetooth_a2dp_src_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$VENDOR_BLUETOOTH_PATH/server:bluetooth_server_static",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
    ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_a2dp_snk_unit_test",
      ":btfw_a2dp_src_unit_test",
      ":btfw_a2dp_parcel_unit_test",
      "service:btfw_a2dp_source_server_test",
      "gavdp:btfw_a2dp_service_unit_test",
      "gavdp:btfw_a2dp_service_statemachine_unit_test",
      "ipc:btfw_a2dp_src_stub_test",
      ":btfw_a2dp_src_stub_unit_test",
      ":btfw_bluetooth_a2dp_src_unit_test",
    ]
  }

  if (bluetooth_a2dp_sink_feature_switch) {
    deps += [
      "service:btfw_a2dp_sink_server_test",
    ]
  }
}
