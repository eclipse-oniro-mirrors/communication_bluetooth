import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

SUBSYSTEM_DIR = "//foundation/communication"
FRAMWORK_DIR = "//foundation/communication"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
module_output_path = "bluetooth/bluetooth"
###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = [
    "-Werror",
    "-Wno-macro-redefined",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unused-const-variable",
    "-Wno-deprecated-builtins",
  ]

  include_dirs = [
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/src",
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner/ipc/common",
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner/ipc/include",
    "$SUBSYSTEM_DIR/bluetooth/frameworks/inner/ipc/interface",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/parcel",
    "$PART_DIR/service/src/sdp_adapter",
    "$PART_DIR/common",
    "$PART_DIR/service/src/common",
    "$PART_DIR/service/src/classic",
    "$PART_DIR/service/src",
    "$PART_DIR/service/src/util",
    "$PART_DIR/service/src/base",
    "//foundation/communication/bluetooth/test/unittest/a2dp/gavdp",
    "$PART_DIR/stack_interface/include/hardware"
  ]
  defines = [
    "HAS_NO_BDROID_BUILDCFG",
    "LOG_TAG = \"bluetooth_test\"",
    "LOG_DOMAIN = 0xD000103",
    "private = public",
  ]
}

ohos_unittest("btfw_sdp_adapter_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true                            # Enable/disable control flow integrity detection
    cfi_cross_dso = true                  # Cross-SO CFI Checks
    debug = false
    blocklist = "./libbt_sdp_adapter_blocklist.txt"
  }
  sources = [ "sdp_adapter_unit_test.cpp" ]

  configs = [
    ":module_private_config",
    "${bluetooth_config_path}:feature_flags",
    "${bluetooth_unittest_utils_path}:unittest_utils_config",
  ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "$PART_DIR/ipc:bt_service_ipc",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/server:bluetooth_server_static",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "common_event_service:cesfwk_innerkits",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "libxml2:libxml2",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_sdp_adapter_unit_test",
    ]
  }
}
