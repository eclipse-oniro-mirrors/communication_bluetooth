import("//build/test.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
BT_SERVICE_DIR = "$PART_DIR/service"
BT_FRAMWORK_DIR = "//foundation/communication/bluetooth/frameworks"
IDL_ROOT = "//foundation/communication/bluetooth/idl"
VENDOR_BLUETOOTH_PATH = "//foundation/communication/bluetooth/services/bluetooth"
BLUETOOTH_ROOT_DIR = "//foundation/communication/bluetooth/test"
###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = [
    "-Werror",
    "-Wno-macro-redefined",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unused-const-variable",
    "-Wno-deprecated-builtins",
    "-Wno-defaulted-function-deleted",
    "-Woverloaded-virtual",
  ]
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "mock/include",
    "$BT_SERVICE_DIR/src/",
    "$BT_SERVICE_DIR/include",
    "$BT_SERVICE_DIR/src/base",
    "$BT_SERVICE_DIR/src/common",
    "$BT_SERVICE_DIR/src/util",
    "$BT_SERVICE_DIR/src/gavdp",
    "$BT_SERVICE_DIR/src/permission",
    "$BT_SERVICE_DIR/src/classic",
    "$BT_SERVICE_DIR/src/hearing_aid",
    "$PART_DIR/common",
    "$PART_DIR/ipc/include",
    "$PART_DIR/btchr/include",
    "$PART_DIR/common/include",
    "$PART_DIR/server/include",
    "$BT_FRAMWORK_DIR/inner/include",
    "//foundation/communication/bluetooth/config",
  ]

  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD005300",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_hearingaid_unit_test") {
  module_out_path = module_output_path

  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    debug = false
  }
  sources = [
    "hearingaid_test.cpp",
  ]
  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$BT_FRAMWORK_DIR/inner/hearingaid:hearingaid_framework",
    "$IDL_ROOT/hearingaid:libbluetooth_hearingaid_interface_stub",
    "$VENDOR_BLUETOOTH_PATH/server:bluetooth_server_static",
    "$PART_DIR/service:bthearing_aid_impl",
    "$PART_DIR/common:btservice_common",
    "$PART_DIR/btchr:btchr",
  ]

  external_deps = [
    "googletest:gmock",
    "googletest:gtest_main",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "resource_management:global_resmgr",
    "access_token:libaccesstoken_sdk",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_hearingaid_server_unit_test") {
  module_out_path = module_output_path

  sources = [
    "hearingaid_server_test.cpp",
  ]
  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$BT_FRAMWORK_DIR/inner/hearingaid:hearingaid_framework",
    "$IDL_ROOT/hearingaid:libbluetooth_hearingaid_interface_stub",
    "$VENDOR_BLUETOOTH_PATH/server:bluetooth_server_static",
    "$PART_DIR/service:bthearing_aid_impl",
    "$PART_DIR/common:btservice_common",
    "$PART_DIR/btchr:btchr",
  ]

  external_deps = [
    "googletest:gmock",
    "googletest:gtest_main",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "access_token:libaccesstoken_sdk",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_hearingaid_service_unit_test") {
  module_out_path = module_output_path

  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    debug = false
    blocklist = "$BLUETOOTH_ROOT_DIR/unittest/cfi_blocklist.txt"
  }
  sources = [
    "hearingaid_service_test.cpp",
  ]
  cflags_cc = [
    "-Woverloaded-virtual",
  ]
  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$BT_FRAMWORK_DIR/inner/hearingaid:hearingaid_framework",
    "$IDL_ROOT/hearingaid:libbluetooth_hearingaid_interface_stub",
    "$VENDOR_BLUETOOTH_PATH/server:bluetooth_server_static",
    "$PART_DIR/service:bthearing_aid_impl",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/common:btservice_common",
    "$PART_DIR/btchr:btchr",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "googletest:gmock_main",
    "googletest:gtest_main",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "hdf_core:libhdi",
    "hdf_core:libhdf_ipc_adapter",
    "hdf_core:libpub_utils",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}


################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
    ":btfw_hearingaid_unit_test",
    ":btfw_hearingaid_server_unit_test",
    ":btfw_hearingaid_service_unit_test",
    ]
  }
}