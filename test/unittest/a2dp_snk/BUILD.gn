import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
SUBSYSTEM_DIR = "//foundation/communication/bluetooth"

config("a2dp_snk_test_config") {
  visibility = [ ":*" ]
  cflags = [
    "-fPIC",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unreachable-code-return",
    "-Wno-defaulted-function-deleted",
    "-Wno-overloaded-virtual",
  ]
  cflags_cc = cflags

  include_dirs = [
    "$SUBSYSTEM_DIR/services/bluetooth/service/src",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/base",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/common",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/util",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/include",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/a2dp_snk",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/avrcp_ct",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/gavdp",
    "mock",
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_a2dp_snk_statemachine_unit_test") {
  module_out_path = module_output_path
  sources = [ "a2dp_snk_state_machine_test.cpp" ]
  configs = [ ":a2dp_snk_test_config" ]
  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$SUBSYSTEM_DIR/services/bluetooth/service:btservice_static",
  ]
  external_deps = [
    "googletest:gmock_main",
    "googletest:gtest_main",
    "c_utils:utils",
    "hilog:libhilog",
    "audio_framework:audio_foundation",
  ]
  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

