################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_avrcp_ct_unit_test",
      ":btfw_avrcp_tg_unit_test",
      ":btfw_avrcp_tg_stub_test",
      ":btfw_refuse_play_helper_test",
      ":btfw_avrcp_ct_observer_stub_test",
      ":btfw_bluetooth_avrcp_tg_observer_stub_test",
      "server:unittest",
      "service:unittest",
    ]
  } else if (defined(target_platform) && target_platform == "car") {
    deps += [
      "service:btfw_avrcp_tg_serv_avsession_media_test",
      "service:btfw_avrcp_tg_serv_avsession_media_loader_test",
      "service:btfw_avrcp_tg_serv_volume_test",
    ]
  }
}
