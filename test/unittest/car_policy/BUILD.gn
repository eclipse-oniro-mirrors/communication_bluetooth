import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
SUBSYSTEM_DIR = "//foundation/communication/bluetooth"
PART_DIR = "$SUBSYSTEM_DIR/services/bluetooth"

car_policy_common_deps = [
  "//foundation/communication/bluetooth/frameworks/inner:btframework",
  "//foundation/communication/bluetooth/frameworks/inner:btcommon",
  "${bluetooth_unittest_utils_path}:unittest_utils_static",
  "$PART_DIR/common:btservice_common_static",
  "$PART_DIR/external:btdummy",
  "$PART_DIR/service:btservice_static",
]

car_policy_common_external_deps = [
  "ability_runtime:ability_manager",
  "access_token:libaccesstoken_sdk",
  "access_token:libnativetoken",
  "access_token:libtoken_setproc",
  "c_utils:utils",
  "common_event_service:cesfwk_innerkits",
  "data_share:datashare_common",
  "data_share:datashare_consumer",
  "googletest:gmock_main",
  "googletest:gtest_main",
  "hilog:libhilog",
  "ipc:ipc_single",
  "libxml2:libxml2",
  "os_account:libaccountkits",
  "os_account:os_account_innerkits",
  "resource_management:global_resmgr",
]

if (bluetooth_ffrt_enable) {
  car_policy_common_external_deps += [ "ffrt:libffrt" ]
}

config("car_policy_test_config") {
  visibility = [ ":*" ]
  cflags = [
    "-fPIC",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unreachable-code-return",
    "-Wno-defaulted-function-deleted",
    "-Wno-overloaded-virtual",
  ]
  cflags_cc = cflags + [ "-fexceptions" ]
  include_dirs = [
    "$SUBSYSTEM_DIR/services/bluetooth/service/src",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/reconnect",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/guard",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/coordinator",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/device",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/smart_call",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/dispatcher",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/service",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/metrics",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/adv",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/base",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/common",
    "$SUBSYSTEM_DIR/services/bluetooth/service/src/util",
    "$SUBSYSTEM_DIR/services/bluetooth/common",
    "$PART_DIR/btchr/include",
    "${bluetooth_unittest_utils_path}",
    "mock",
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_car_policy_config_unit_test") {
  module_out_path = module_output_path
  sources = [
    "car_policy_config_test.cpp",
  ]
  configs = [ ":car_policy_test_config" ]
  deps = car_policy_common_deps
  external_deps = car_policy_common_external_deps
}

if (bluetooth_car_policy_feature_switch) {
  ohos_unittest("btfw_car_policy_device_unit_test") {
    module_out_path = module_output_path
    sources = [
      "car_device_type_resolver_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_car_metrics_reporter_unit_test") {
    module_out_path = module_output_path
    sources = [
      "car_metrics_reporter_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps + [ "$PART_DIR/btchr:btchr" ]
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_pairable_adv_controller_unit_test") {
    module_out_path = module_output_path
    sources = [
      "pairable_adv_controller_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_car_connection_guard_unit_test") {
    module_out_path = module_output_path
    sources = [
      "car_connection_guard_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_device_priority_manager_unit_test") {
    module_out_path = module_output_path
    sources = [
      "device_priority_manager_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_reconnect_engine_unit_test") {
    module_out_path = module_output_path
    sources = [
      "reconnect_engine_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_car_policy_predicates_unit_test") {
    module_out_path = module_output_path
    sources = [
      "reconnect_predicates_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_smart_call_transfer_controller_unit_test") {
    module_out_path = module_output_path
    sources = [
      "smart_call_transfer_controller_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_car_policy_manager_unit_test") {
    module_out_path = module_output_path
    sources = [
      "car_policy_manager_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }

  ohos_unittest("btfw_sub_profile_switch_handler_unit_test") {
    module_out_path = module_output_path
    sources = [
      "sub_profile_switch_handler_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    deps = car_policy_common_deps
    external_deps = car_policy_common_external_deps
  }
}

if (bluetooth_multi_a2dp_enabled) {
  ohos_unittest("btfw_multi_a2dp_manager_unit_test") {
    module_out_path = module_output_path
    sources = [
      "multi_a2dp_manager_test.cpp",
    ]
    configs = [ ":car_policy_test_config" ]
    defines = [ "MULTI_A2DP_ENABLED" ]
    include_dirs = [
      "$SUBSYSTEM_DIR/services/bluetooth/service/src/car_policy/multi_a2dp",
      "//base/account/os_account/interfaces/innerkits/osaccount/native/include",
    ]
    deps = car_policy_common_deps + [ "$PART_DIR/vendor_interface:vendor_interface" ]
    external_deps = car_policy_common_external_deps + [
      "window_manager:libdm",
    ]
  }
}

group("unittest") {
  testonly = true
  deps = [ ":btfw_car_policy_config_unit_test" ]
  if (bluetooth_car_policy_feature_switch) {
    deps += [
      ":btfw_car_policy_predicates_unit_test",
      ":btfw_car_policy_device_unit_test",
      ":btfw_car_metrics_reporter_unit_test",
      ":btfw_pairable_adv_controller_unit_test",
      ":btfw_car_connection_guard_unit_test",
      ":btfw_device_priority_manager_unit_test",
      ":btfw_reconnect_engine_unit_test",
      ":btfw_smart_call_transfer_controller_unit_test",
      ":btfw_car_policy_manager_unit_test",
      ":btfw_sub_profile_switch_handler_unit_test",
    ]
  }
  if (bluetooth_multi_a2dp_enabled) {
    deps += [
      ":btfw_multi_a2dp_manager_unit_test"
    ]
  }
}
