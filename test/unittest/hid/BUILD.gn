################################################################################
group("unittest") {
  testonly = true

  deps = []

  if (is_phone_product) {
    deps += [
      ":btfw_hid_unit_test",
      ":btfw_hid_statemachine_test",
      ":btfw_hid_service_test",
      "stub:btfw_hid_stub_test",
    ]
  }
  if (bluetooth_hid_device_feature_switch) {
    deps += [
      ":btfw_hid_device_unit_test",
      ":btfw_hid_device_parcel_test",
      ":btfw_hid_device_server_unit_test",
      ":btfw_hid_device_service_test",
      ":btfw_hid_device_service_impl_test",
    ]
  } 
}
