      "${bluetooth_unittest_utils_path}:unittest_utils_static",
      "$PART_DIR/service:btservice_static",
      "$PART_DIR/common:btservice_common",
      "$PART_DIR/stack_interface:stack_interface",
    ]

    external_deps = [
      "googletest:gmock_main",
      "googletest:gtest_main",
      "ability_runtime:ability_manager",
      "ability_runtime:app_manager",
      "samgr:samgr_proxy",
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_single",
    ]

    if (bluetooth_ffrt_enable) {
      external_deps += [ "ffrt:libffrt" ]
    }
  }

ohos_unittest("btfw_hid_device_parcel_test") {
    module_out_path = module_output_path
    sources = [ "hid_device_parcel_test.cpp" ]

    configs = [ ":module_private_config" ]
    deps = [
