import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
FRAMWORK_DIR = "//foundation/communication"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
BT_SERVICE_DIR = "$PART_DIR/service"

###############################################################################
#1. intent(c++) get/set test without transport

config("btservice_public_config") {
  visibility = [ ":*" ]
  cflags = [
    "-Werror",
    "-Wno-macro-redefined",
    "-Wno-non-c-typedef-for-linkage",
    "-Wno-unused-const-variable",
    "-Wno-deprecated-builtins",
  ]
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "mock/include",
    "$PART_DIR/ipc/common",
    "$PART_DIR/common",
    "$PART_DIR/service/src/common",
    "$PART_DIR/server/include",
    "$FRAMWORK_DIR/bluetooth/interfaces/inner_api/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/parcel",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/common",
    "$BT_SERVICE_DIR/include",
    "$BT_SERVICE_DIR/src",
    "$BT_SERVICE_DIR/src/base",
    "$BT_SERVICE_DIR/src/common",
    "$BT_SERVICE_DIR/src/dialog",
    "$BT_SERVICE_DIR/src/permission",
    "$BT_SERVICE_DIR/src/util",
    "$BT_SERVICE_DIR/src/ble/ble_scan_filter",
    "$BT_SERVICE_DIR/src/classic",
    "$BT_SERVICE_DIR/src/ble",
    "$BT_SERVICE_DIR/src/hfp_ag",
    "$BT_SERVICE_DIR/src/gavdp",
    "$BT_SERVICE_DIR/src/hid_host",
    #"$FRAMWORK_DIR/netmanager_base/services/netmanagernative/include/netsys",
    "//foundation/communication/bluetooth/test/unittest/config"
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD005300",
    "private = public",
  ]
}

ohos_unittest("btfw_power_classic_adapter_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true                            # Enable/disable control flow integrity detection
    cfi_cross_dso = true                  # Cross-SO CFI Checks
    debug = false
    blocklist = "libbt_power_classic_adapter_blocklist.txt"
  }
  sources = [
    "classic_adapter_test.cpp",
  ]

  configs = [
    ":btservice_public_config",
    "${bluetooth_config_path}:feature_flags"
  ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "$PART_DIR/external:btdummy",
    "$PART_DIR/service:btservice_static",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
    "$PART_DIR/stack_interface:stack_interface",
    "$PART_DIR/vendor_interface:vendor_interface",
  ]

  external_deps = [
    "ability_runtime:abilitykit_native",
    "ability_runtime:extension_manager",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "data_share:datashare_common",
    "data_share:datashare_consumer",
    "libxml2:libxml2",
  ]

  if (bluetooth_audio_framwwork) {
    external_deps += [
      "audio_framework:audio_policy_manager",
    ]
  }

  if (bluetooth_hfp_ag_feature_switch) {
    external_deps += [
      "call_manager:tel_call_manager_api",
      "core_service:tel_core_service_api",
      "state_registry:tel_state_registry_api",
    ]
  }

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

