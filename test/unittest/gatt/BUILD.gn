import("//build/test.gni")
import("//foundation/communication/bluetooth/test/unittest/unittest.gni")

module_output_path = "bluetooth/bluetooth"
FRAMWORK_DIR = "//foundation/communication"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
BT_SERVICE_DIR = "$PART_DIR/service"

###############################################################################
#1. intent(c++) get/set test without transport

config("module_private_config") {
  visibility = [ ":*" ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  include_dirs = [
    "mock/include",
    "$FRAMWORK_DIR/bluetooth/interfaces/inner_api/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/common",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/parcel",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/ipc/interface",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/include",
    "$FRAMWORK_DIR/bluetooth/frameworks/inner/src",
    "$PART_DIR/server/include",
    "$BT_SERVICE_DIR/include",
    "$BT_SERVICE_DIR/src/base",
    "$BT_SERVICE_DIR/src/gatt",
    "$BT_SERVICE_DIR/src/common",
    "$BT_SERVICE_DIR/src/util",
  ]
  defines = [
    "BTFW_LOG_TAG = \"bluetooth_test\"",
    "BTFW_LOG_DOMAIN = 0xD000103",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("btfw_gatt_service_unit_test") {
  module_out_path = module_output_path

  sources = [ "gatt_service_test.cpp" ]

  configs = [ ":module_private_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "resource_management:global_resmgr",
    "samgr:samgr_proxy",
  ]

  if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
  }
}

ohos_unittest("btfw_gatt_client_unit_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    debug = false
  }
  sources = [ "gatt_client_test.cpp", ]

  configs = [ ":module_private_config" ]
  configs += [ "${bluetooth_unittest_utils_path}:unittest_utils_config" ]

  deps = [
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "${bluetooth_unittest_utils_path}:unittest_utils_static",
