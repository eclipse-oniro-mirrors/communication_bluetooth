#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/communication/bluetooth/test/fuzztest/fuzztest.gni")

module_output_path = "bluetooth/bluetooth"
SUBSYSTEM_DIR = "//foundation/communication/bluetooth"
PART_DIR = "$SUBSYSTEM_DIR/services/bluetooth"

##############################fuzztest##########################################
ohos_fuzztest("CarMetricsReporterFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "$SUBSYSTEM_DIR/test/fuzztest/car_policy/car_metrics_reporter_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  include_dirs = [
    "$PART_DIR/service/src/car_policy",
    "$PART_DIR/service/src/car_policy/metrics",
    "$PART_DIR/btchr/include",
    "$PART_DIR/service/src/util",
    "$PART_DIR/common",
    "$PART_DIR/service/src",
  ]

  configs = [
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_config",
  ]

  deps = [
    "$PART_DIR/btchr:btchr",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/common:btservice_common_static",
    "$PART_DIR/external:btdummy",
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_static",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  sources = [
    "car_metrics_reporter_fuzzer.cpp",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "libxml2:libxml2",
    "resource_management:global_resmgr",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = [
    ":CarMetricsReporterFuzzTest",
  ]
}
###############################################################################
