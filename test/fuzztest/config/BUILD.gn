import("//build/test.gni")
import("//foundation/communication/bluetooth/test/fuzztest/fuzztest.gni")

PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"

config("fuzztest_utils_config") {
  include_dirs = [
    "${bluetooth_fuzztest_utils_path}",
    "$PART_DIR/common",
    "$PART_DIR/service/include",
    "$PART_DIR/service/src",
    "$PART_DIR/service/src/base",
    "$PART_DIR/service/src/common",
    "$PART_DIR/service/src/classic",
    "$PART_DIR/service/src/obex",
    "$PART_DIR/service/src/opp",
    "$PART_DIR/service/src/map_mse",
    "$PART_DIR/service/src/pbap_pse",
    "$PART_DIR/service/src/sock",
    "$PART_DIR/service/src/util",
    "//foundation/communication/bluetooth/frameworks/inner/ipc/common",
  ]

  cflags_cc = [
    "-Wno-format",
    "-Wno-unused-parameter",
    "-Wno-unused-function",
  ]
}

# Only used for fuzztest
ohos_static_library("fuzztest_utils_static") {
  sources = [
    "bluetooth_access_token_mock.cpp"
  ]
  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "c_utils:utils",
  ]

  subsystem_name = "communication"
  part_name = "bluetooth"
}