#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/communication/bluetooth/test/fuzztest/fuzztest.gni")

module_output_path = "bluetooth/bluetooth"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"
BT_SERVICE_DIR = "$PART_DIR/service"

##############################fuzztest##########################################
ohos_fuzztest("ObexFileBodyObjectFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "//foundation/communication/bluetooth/test/fuzztest/obex/obexfilebodyobject_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-non-c-typedef-for-linkage",
  ]
  include_dirs = [
    "$PART_DIR/ipc/include",
    "$PART_DIR/server/include",
    "$PART_DIR/btchr/include",
    "$PART_DIR/common",
    "$PART_DIR/common/include",
    "$PART_DIR/config",
    "$BT_SERVICE_DIR/include",
    "$BT_SERVICE_DIR/src",
    "$BT_SERVICE_DIR/src/base",
    "$BT_SERVICE_DIR/src/common",
    "$BT_SERVICE_DIR/src/util",
    "$BT_SERVICE_DIR/src/permission",
    "$BT_SERVICE_DIR/src/opp",
    "$BT_SERVICE_DIR/src/obex",
  ]

  configs = [
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_config",
    "${bluetooth_config_path}:feature_flags",
  ]

  sources = [
    "obex_file_body_object_fuzzer.cpp",
    "../../bt_utils/fuzztest_utils.cpp",
  ]

  deps = [
    "$PART_DIR/ipc:bt_service_ipc",
    "$PART_DIR/server:bluetooth_server_static",
    "$PART_DIR/service:btopp",
    "$PART_DIR/service:btmap_mse_static",
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_static",
    "$BT_SERVICE_DIR/src/obex:bt_obex",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libprivacy_sdk",
    "access_token:libtokenid_sdk",
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:ability_connect_callback_stub",
    "ability_runtime:ability_manager",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "ffrt:libffrt",
    "hilog:libhilog",
    "ipc:ipc_single",
    "samgr:samgr_proxy",
    "bounds_checking_function:libsec_shared",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    ":ObexFileBodyObjectFuzzTest",
  ]
}
###############################################################################
