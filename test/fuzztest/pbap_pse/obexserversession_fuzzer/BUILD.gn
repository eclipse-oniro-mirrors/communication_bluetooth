#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
import("//foundation/communication/bluetooth/test/fuzztest/fuzztest.gni")
module_output_path = "bluetooth/bluetooth"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"

##############################fuzztest##########################################
if (bluetooth_pbap_pse_feature_switch) {
ohos_fuzztest("ObexServerSessionFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "//foundation/communication/bluetooth/test/fuzztest/pbap_pse/obexserversession_fuzzer"

  include_dirs = [
    "$PART_DIR/service/src/pbap_pse",
    ".",
    "$PART_DIR/common/include",
    "$bluetooth_mock_path",
    "$PART_DIR/service/src/permission",
  ]

  configs = [
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_config",
    "${bluetooth_config_path}:feature_flags",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-Wno-non-c-typedef-for-linkage",
    "-fno-omit-frame-pointer"
  ]
  sources = [
    "obexserversession_fuzzer.cpp",
    "adapter_device_config_mock.cpp",
    "$PART_DIR/service/src/pbap_pse/pbab_pse_vcard_filter.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_appparam.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_datashare_utils.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_obex_server.cpp",
    # "$PART_DIR/service/src/pbap_pse/pbap_pse_service.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_service_impl.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_statemachine.cpp",
    "$PART_DIR/service/src/pbap_pse/pbap_pse_vcard_manager.cpp",

    "$PART_DIR/common/src/common_util.cpp",
    "$PART_DIR/common/src/state_machine.cpp",
    "../../bt_utils/fuzztest_utils.cpp",
  ]
  if (bluetooth_ffrt_enable) {
    sources += [
      "$PART_DIR/common/src/thread_util.cpp",
      "$PART_DIR/common/src/timer_manager_ffrt.cpp",
      ]
  } else {
    sources += [
      "$PART_DIR/common/src/thread_util_event_handler.cpp",
      "$PART_DIR/common/src/timer_manager.cpp",
    ]
  }

  deps = [
    # "$PART_DIR/common:btservice_common",
    "$PART_DIR/ipc:bt_service_ipc",
    # "$PART_DIR/server:bluetooth_server_static",
    "$PART_DIR/service/src/obex:bt_obex",
    # "$PART_DIR/service:btpbap_pse",
    "$PART_DIR/service:btmap_mse",
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_static",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libprivacy_sdk",
    "access_token:libtokenid_sdk",
    "ability_base:want",
    "ability_base:zuri",
    "hilog:libhilog",
    "ipc:ipc_single",
    # "data_share:datashare_common",
    # "data_share:datashare_consumer",
    "sms_mms:tel_sms_mms_api",
    "core_service:tel_core_service_api",
    "state_registry:tel_state_registry_api",
    "call_manager:tel_call_manager_api",
    "audio_framework:audio_policy_manager",
    "samgr:samgr_proxy",
    "core_service:libtel_vcard",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "common_event_service:cesfwk_innerkits",
    "os_account:libaccountkits",
    "os_account:os_account_innerkits",
    "bounds_checking_function:libsec_shared",
  ]
if (bluetooth_ffrt_enable) {
    external_deps += [ "ffrt:libffrt" ]
}
}
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  if (bluetooth_pbap_pse_feature_switch) {
    deps += [
      # deps file
      ":ObexServerSessionFuzzTest",
    ]
  }
}
###############################################################################
