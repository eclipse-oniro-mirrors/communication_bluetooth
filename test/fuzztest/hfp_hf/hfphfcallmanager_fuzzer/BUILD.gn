#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/communication/bluetooth/test/fuzztest/fuzztest.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")
module_output_path = "bluetooth/bluetooth"
PART_DIR = "//foundation/communication/bluetooth/services/bluetooth"

##############################fuzztest##########################################
if (bluetooth_hfp_hf_feature_switch) {
ohos_fuzztest("HfpHfCallManagerFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "//foundation/communication/bluetooth/test/fuzztest/hfp_hf/hfphfcallmanager_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-non-c-typedef-for-linkage",
  ]
  include_dirs = [
    "$PART_DIR/ipc/include",
    "$PART_DIR/common/include",
    "$PART_DIR/service/src/common",
    "$PART_DIR/service/src/hfp_hf",
    "$PART_DIR/service/src/permission",
  ]

  defines = [
    "private = public",
  ]

  configs = [
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_config",
    "${bluetooth_config_path}:feature_flags",
  ]

  sources = [
    "hfphfcallmanager_fuzzer.cpp",
    "../../bt_utils/fuzztest_utils.cpp",
    "$PART_DIR/service/src/hfp_hf/hfp_hf_call_manager.cpp",
  ]

  deps = [
    "$PART_DIR/ipc:bt_service_ipc",
    "$PART_DIR/server:bluetooth_server_static",
    "$PART_DIR/service:btservice_static",
    "$PART_DIR/common:btservice_common",
    "${bluetooth_fuzztest_utils_path}:fuzztest_utils_static",
    "//foundation/communication/bluetooth/frameworks/inner:btcommon",
    "//foundation/communication/bluetooth/frameworks/inner:btframework",
    "//foundation/communication/bluetooth/services/bluetooth/stack_interface:stack_interface",
  ]

  external_deps = [
    "ffrt:libffrt",
    "access_token:libaccesstoken_sdk",
    "access_token:libprivacy_sdk",
    "access_token:libtokenid_sdk",
    "hilog:libhilog",
    "ipc:ipc_single",
    "bounds_checking_function:libsec_shared",
    "call_manager:tel_call_manager_api",
  ]

  if (bluetooth_call_focus_supported) {
    external_deps += [
      "audio_framework:audio_foundation",
      "audio_framework:audio_client",
    ]
  }
}
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  if (bluetooth_hfp_hf_feature_switch) {
    deps += [
      ":HfpHfCallManagerFuzzTest",
    ]
  }
}
###############################################################################
