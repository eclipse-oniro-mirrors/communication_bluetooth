import("//build/ohos.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")

BT_ROOT = "//foundation/communication/bluetooth/services/bluetooth"

config("vendor_interface_public_config") {
  include_dirs = [
    "$BT_ROOT/vendor_interface/include",
  ]
}

ohos_shared_library("vendor_interface") {
  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  # stack_protector_ret = true
  sanitize = {
      cfi = true                             # Enable/disable control flow integrity detection
      boundary_sanitize = true               # Enable boundary san detection
      cfi_cross_dso = true                   # Cross-SO CFI Checks
      integer_overflow = true                # Enable integer overflow detection
      ubsan = true                           # Enable some Ubsan options
      debug = false
  }

  cflags_cc = [
    "-Os",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
    "-Wno-format",
    "-Wno-return-type-c-linkage",
  ]

  public_configs = [ ":vendor_interface_public_config" ]

  # Export the wrapper classes for other shared libraries (btfast_scan/btpan).
  # Without this, the CFI version script hides all non-cfi symbols.
  version_script = "libvendor_interface_version_script.txt"

  configs = [
     ":vendor_interface_public_config",
     "${bluetooth_config_path}:feature_flags",
  ]

  include_dirs = [
    "include",
  ]

  sources = [
    "src/vendor_interface.cpp",
    "src/vendor_loader.cpp",
    "src/dhcp_interface.cpp",
    "src/appgallery_interface.cpp",
    "src/power_interface.cpp",
    "src/space_mgr_interface.cpp",
    "src/zone_audio_interface.cpp",
  ]

  # The vendor library is loaded with dlopen at runtime, so no link-time dep.
  external_deps = [
    "hilog:libhilog",
  ]

  part_name = "bluetooth"
  subsystem_name = "communication"
}