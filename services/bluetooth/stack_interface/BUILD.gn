import("//build/ohos.gni")
import("//build/ohos_var.gni")
import("//foundation/communication/bluetooth/bluetooth.gni")

config("stack_interface_config") {
    cflags_cc = [
        "-Os",
        "-fno-rtti",
        "-fno-exceptions",
        "-fdata-sections",
        "-ffunction-sections",
        "-fno-unwind-tables",
        "-fno-asynchronous-unwind-tables",
        "-fno-merge-all-constants",
        "-flto",
        "-Wno-non-c-typedef-for-linkage",
    ]
}

config("stack_interface_public_config") {
    include_dirs = [
        ".",
        "include",
        "include/hardware",
        "include/hardware/avrcp",
        "include/stack/include",
        "include/types",
        "//foundation/communication/bluetooth/services/bluetooth/service/src/a2dp_snk",
        "//foundation/communication/bluetooth/services/bluetooth/common",
    ]
}
stack_interface_sources = [
    "src/hal_util.cpp",
    "src/raw_address.cpp",
    "src/stack_stub.cpp",
    "src/uuid.cpp",
]

stack_interface_external_deps = [
    "hilog:libhilog",
    "bounds_checking_function:libsec_shared",
    "audio_framework:audio_renderer",
    "audio_framework:audio_client",
]

# Dynamic library exported to other components via bundle.json innerApis.
ohos_shared_library("stack_interface") {
    branch_protector_ret = "pac_ret"  # Enable PAC CFI
    sanitize = {
        cfi = true
        boundary_sanitize = true
        integer_overflow = true
        cfi_cross_dso = true
        ubsan = true
        debug = false
    }
    configs = [
        ":stack_interface_config",
    ]
    public_configs = [ ":stack_interface_public_config" ]

    sources = stack_interface_sources

    external_deps = stack_interface_external_deps

    part_name = "bluetooth"
    subsystem_name = "communication"
}

# Static twin for in-part targets that link the sources directly.
ohos_static_library("stack_interface_static") {
    branch_protector_ret = "pac_ret"  # Enable PAC CFI
    sanitize = {
        cfi = true
        boundary_sanitize = true
        integer_overflow = true
        cfi_cross_dso = true
        ubsan = true
        debug = false
    }

    configs = [
        ":stack_interface_config",
        "${bluetooth_config_path}:feature_flags",
    ]
    public_configs = [ ":stack_interface_public_config" ]

    sources = stack_interface_sources

    external_deps = stack_interface_external_deps

    part_name = "bluetooth"
    subsystem_name = "communication"
}
